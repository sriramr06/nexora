# Copy to server/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend URL used in email links
APP_URL=http://localhost:5173

# Atlas dev cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/nexora?retryWrites=true&w=majority

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Email: "console" prints emails to the terminal (development).
# "gmail_api" (production, Gmail REST API over HTTPS) or "smtp" send real emails.
EMAIL_TRANSPORT=console
EMAIL_FROM="Nexora <no-reply@nexora.local>"
# Only needed when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Only needed when EMAIL_TRANSPORT=gmail_api (OAuth client + refresh token, scope gmail.send)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Added in later steps: CLOUDINARY_*
