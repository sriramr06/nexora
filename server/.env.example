# Copy to server/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend URL used in email links
APP_URL=http://localhost:5173

# Atlas dev cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/nexora?retryWrites=true&w=majority

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Added in later steps: EMAIL_TRANSPORT, SMTP_*, EMAIL_FROM, CLOUDINARY_*
